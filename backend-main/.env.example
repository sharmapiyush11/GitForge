PORT=3002
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gitforge
JWT_SECRET_KEY=replace_with_a_long_random_secret_string
CORS_ORIGIN=http://localhost:5173
# Optional AWS S3 remote storage for CLI push/pull (falls back to MongoDB/local remote if unset)
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
